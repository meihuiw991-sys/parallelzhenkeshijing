# JoyAI Video Edit WebSocket
MODEL_WS_URL=wss://rd4804afd0fc-2e44g-aigw-pub.bj.baidubce.com/ws
MODEL_HEALTH_URL=https://rd4804afd0fc-2e44g-aigw-pub.bj.baidubce.com/health

# Fill in your API key. It is sent as: Authorization: Bearer <key>
MODEL_API_KEY=
MODEL_API_KEY_2=
# Fixed model settings recommended by docs/API.md
MODEL_WIDTH=1248
MODEL_HEIGHT=720
MODEL_FPS=24
MODEL_INPUT_CODEC=mjpeg
MODEL_OUTPUT_CODEC=mjpeg
MODEL_OUTPUT_QUALITY=85
MODEL_GATE_ENABLED=false
MODEL_USE_PE=false

# Local Render Gateway
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# JoyAI Talker uses the second model key.
TALKER_WS_URL=ws://hubrouter.jd.com/v1/realtime?model=JoyAI-Talker
INTERACTION_URL=https://hubrouter.jd.com/v1/chat/completions
INTERACTION_MODEL=JoyAI-VL-Interaction
INTERACTION_TIMEOUT_SECONDS=20
